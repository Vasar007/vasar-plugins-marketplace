// markdownlint rules for the .md files of this repository. The base is the
// configuration that the write-markdown skill recommends. Each other change
// names its reason.
{
  "default": true,
  // Skill, prompt, and doc files keep one paragraph on one line.
  "MD013": false,
  "MD024": { "siblings_only": true },
  // Stage prompt files have a file title and a prompt title. Review examples
  // show a whole report with its own title.
  "MD025": false,
  // Step numbers continue across headings, and other text points to a step
  // by its number.
  "MD029": false,
  "MD033": { "allowed_elements": ["details", "summary", "br"] },
  // Command, agent, and stage prompt files start with frontmatter and the
  // prompt text, not with a heading.
  "MD041": false,
  // The write-markdown conventions set no table column style.
  "MD060": false
}
