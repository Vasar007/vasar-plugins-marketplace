diff --git a/src/pager.py b/src/pager.py
index 5dd762b..8d77c77 100644
--- a/src/pager.py
+++ b/src/pager.py
@@ -14,3 +14,8 @@ def total_pages(total_items, size=DEFAULT_PAGE_SIZE):
 def has_next_page(page, total_items, size=DEFAULT_PAGE_SIZE):
     """Return True if a page after the given page (1-based) exists."""
     return page < total_pages(total_items, size)
+
+
+def pageCount(items, size=DEFAULT_PAGE_SIZE):
+    """Return the number of pages for a list of items."""
+    return total_pages(len(items), size)
diff --git a/src/ranges.py b/src/ranges.py
index f092bf2..4afb191 100644
--- a/src/ranges.py
+++ b/src/ranges.py
@@ -7,3 +7,8 @@ def page_numbers(count):
     The numbers are 1-based, inclusive: for 3 pages the result is [1, 2, 3].
     """
     return list(range(1, count + 1))
+
+
+def lastPage(count):
+    """Return the number of the last page of count pages, or 0 for no pages."""
+    return count
