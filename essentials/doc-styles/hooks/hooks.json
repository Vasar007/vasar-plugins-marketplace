{
  "description": "Lint a Markdown document in the OpenBSD manual style after each write.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/skills/openbsd-style-docs/scripts/openbsd_lint.py\" --hook",
            "timeout": 10,
            "statusMessage": "OpenBSD style: checking the file..."
          }
        ]
      }
    ]
  }
}
